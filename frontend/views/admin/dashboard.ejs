<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3"><div class="admin-stat bg-white"><div class="d-flex justify-content-between"><span class="small text-muted">Doanh thu</span><i class="bi bi-currency-exchange stat-icon text-success"></i></div><div class="h3 mt-3 mb-0"><%= (stats.revenue || 0).toLocaleString('vi-VN') %>₫</div></div></div>
  <div class="col-6 col-xl-3"><div class="admin-stat bg-white"><div class="d-flex justify-content-between"><span class="small text-muted">Đơn hàng</span><i class="bi bi-receipt stat-icon text-primary"></i></div><div class="h3 mt-3 mb-0"><%= stats.totalOrders || 0 %></div></div></div>
  <div class="col-6 col-xl-3"><div class="admin-stat bg-white"><div class="d-flex justify-content-between"><span class="small text-muted">Sản phẩm đang bán</span><i class="bi bi-box-seam stat-icon text-warning"></i></div><div class="h3 mt-3 mb-0"><%= stats.totalProducts || 0 %></div></div></div>
  <div class="col-6 col-xl-3"><div class="admin-stat bg-white"><div class="d-flex justify-content-between"><span class="small text-muted">Người dùng</span><i class="bi bi-people stat-icon text-secondary"></i></div><div class="h3 mt-3 mb-0"><%= stats.totalUsers || 0 %></div></div></div>
</div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 d-flex justify-content-between align-items-center py-3"><div><div class="section-kicker">Cập nhật mới</div><h2 class="h5 mb-0">Đơn hàng gần đây</h2></div><a href="/admin/orders" class="btn btn-sm btn-shop-dark">Tất cả đơn hàng</a></div>
  <div class="table-responsive"><table class="table admin-table mb-0"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    <% if (recentOrders && recentOrders.length) { recentOrders.forEach(order => { %><tr><td class="fw-semibold">#<%= order._id.toString().slice(-8).toUpperCase() %></td><td><%= order.user ? order.user.name : 'Khách hàng' %></td><td><%= new Date(order.createdAt).toLocaleDateString('vi-VN') %></td><td><%= order.totalPrice.toLocaleString('vi-VN') %>₫</td><td><span class="order-status"><%= order.status %></span></td><td><a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Chi tiết</a></td></tr><% }) } else { %><tr><td colspan="6" class="text-center text-muted py-5">Chưa có đơn hàng nào</td></tr><% } %>
  </tbody></table></div>
</div>
