<!-- ===== ADMIN: DANH SÁCH ĐƠN HÀNG ===== -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Quản lý đơn hàng</h5>
  <!-- Lọc theo trạng thái -->
  <form action="/admin/orders" method="GET">
    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width:200px;">
      <option value="">-- Tất cả trạng thái --</option>
      <option value="pending"   <%= filter === 'pending'   ? 'selected' : '' %>>Chờ xử lý</option>
      <option value="confirmed" <%= filter === 'confirmed' ? 'selected' : '' %>>Đã xác nhận</option>
      <option value="shipping"  <%= filter === 'shipping'  ? 'selected' : '' %>>Đang giao</option>
      <option value="delivered" <%= filter === 'delivered' ? 'selected' : '' %>>Đã giao</option>
      <option value="cancelled" <%= filter === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
    </select>
  </form>
</div>

<!-- Bảng đơn hàng -->
<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Mã đơn</th>
          <th>Khách hàng</th>
          <th>Tổng tiền</th>
          <th>Ngày đặt</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr>
              <td>#<%= order._id.toString().slice(-8).toUpperCase() %></td>
              <td><%= order.user ? order.user.name : order.name %></td>
              <td class="text-danger"><%= order.totalPrice.toLocaleString('vi-VN') %>đ</td>
              <td><%= new Date(order.createdAt).toLocaleDateString('vi-VN') %></td>
              <td>
                <!-- Badge trạng thái -->
                <%
                  const statusColors = {
                    pending: 'warning', confirmed: 'info',
                    shipping: 'primary', delivered: 'success', cancelled: 'danger'
                  };
                %>
                <span class="badge bg-<%= statusColors[order.status] || 'secondary' %>"><%= order.status %></span>
              </td>
              <td>
                <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-dark">Chi tiết</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có đơn hàng nào.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Phân trang -->
<div class="mt-3">
  <%- include('../../partials/pagination', { currentPage, totalPages, baseUrl: '/admin/orders' }) %>
</div>

