<!-- ===== ADMIN: DANH SÁCH SẢN PHẨM ===== -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Quản lý sản phẩm</h5>
  <a href="/admin/products/create" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
</div>

<!-- Thanh tìm kiếm -->
<form action="/admin/products" method="GET" class="mb-3">
  <div class="input-group" style="max-width:400px;">
    <input type="text" name="q" class="form-control" placeholder="Tìm sản phẩm..." value="<%= query || '' %>">
    <button class="btn btn-dark">Tìm</button>
  </div>
</form>

<!-- Bảng sản phẩm -->
<div class="card">
  <div class="card-body p-0">
    <table class="table admin-table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Ảnh</th>
          <th>Tên sản phẩm</th>
          <th>Danh mục</th>
          <th>Giá</th>
          <th>Tồn kho</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach((product, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><img src="<%= product.image || '/images/no-image.png' %>" style="width:50px; height:50px; object-fit:cover;" class="rounded"></td>
              <td><%= product.name %></td>
              <td><%= product.category ? product.category.name : '—' %></td>
              <td><%= product.price.toLocaleString('vi-VN') %>đ</td>
              <td><%= product.stock %></td>
              <td>
                <a href="/admin/products/edit/<%= product._id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                <form action="/admin/products/delete/<%= product._id %>" method="POST" class="d-inline"
                      onsubmit="return confirm('Xóa sản phẩm này?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Phân trang -->
<div class="mt-3">
  <%- include('../../partials/pagination', { currentPage, totalPages, baseUrl: '/admin/products' }) %>
</div>

