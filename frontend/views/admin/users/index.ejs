<!-- ===== ADMIN: QUẢN LÝ NGƯỜI DÙNG ===== -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Quản lý người dùng</h5>
  <span class="text-muted">Tổng: <strong><%= users ? users.length : 0 %></strong> tài khoản</span>
</div>

<!-- Thanh tìm kiếm -->
<form action="/admin/users" method="GET" class="mb-3">
  <div class="input-group" style="max-width:400px;">
    <input type="text" name="q" class="form-control" placeholder="Tìm theo tên hoặc email..." value="<%= query || '' %>">
    <button class="btn btn-dark">Tìm</button>
  </div>
</form>

<!-- Bảng người dùng -->
<div class="card">
  <div class="card-body p-0">
    <table class="table admin-table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Họ tên</th>
          <th>Email</th>
          <th>SĐT</th>
          <th>Vai trò</th>
          <th>Ngày tạo</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach((u, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= u.name %></td>
              <td><%= u.email %></td>
              <td><%= u.phone || '—' %></td>
              <td>
                <!-- Badge vai trò: admin màu đỏ, user màu xám -->
                <span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>">
                  <%= u.role || 'user' %>
                </span>
              </td>
              <td><%= new Date(u.createdAt).toLocaleDateString('vi-VN') %></td>
              <td>
                <!-- Nút xóa (không cho xóa chính mình) -->
                <form action="/admin/users/delete/<%= u._id %>" method="POST" class="d-inline"
                      onsubmit="return confirm('Xóa người dùng này?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có người dùng nào.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Phân trang -->
<div class="mt-3">
  <%- include('../../partials/pagination', { currentPage, totalPages, baseUrl: '/admin/users' }) %>
</div>

