<!-- ===== TRANG QUÊN MẬT KHẨU ===== -->
<div class="card shadow-sm">
  <div class="card-body p-4">
    <h4 class="card-title text-center mb-2">Quên mật khẩu</h4>
    <p class="text-center text-muted mb-4">Nhập email để nhận link đặt lại mật khẩu</p>

    <!-- Thông báo thành công -->
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <!-- Thông báo lỗi -->
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/forgot-password" method="POST">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="email@example.com" required>
      </div>
      <button type="submit" class="btn btn-dark w-100">Gửi link đặt lại</button>
    </form>

    <div class="text-center mt-3">
      <a href="/login" class="text-secondary">← Quay lại đăng nhập</a>
    </div>
  </div>
</div>

