<!-- ===== TRANG GIỎ HÀNG ===== -->
<h4 class="mb-4">Giỏ hàng của bạn</h4>

<% if (cartItems && cartItems.length > 0) { %>
  <div class="row">
    <!-- Danh sách sản phẩm trong giỏ -->
    <div class="col-md-8">
      <div class="card">
        <div class="card-body p-0">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Size/Màu</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% cartItems.forEach(item => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= item.product.image || '/images/no-image.png' %>" style="width:50px; height:50px; object-fit:cover;" class="rounded">
                      <span><%= item.product.name %></span>
                    </div>
                  </td>
                  <td><%= item.product.price.toLocaleString('vi-VN') %>đ</td>
                  <td><%= item.size %> / <%= item.color %></td>
                  <td><%= item.quantity %></td>
                  <td class="text-danger fw-bold"><%= (item.product.price * item.quantity).toLocaleString('vi-VN') %>đ</td>
                  <td>
                    <!-- Nút xóa khỏi giỏ -->
                    <form action="/cart/remove/<%= item._id %>" method="POST">
                      <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tổng tiền -->
    <div class="col-md-4">
      <div class="card p-3">
        <h6 class="fw-bold mb-3">Tóm tắt đơn hàng</h6>
        <div class="d-flex justify-content-between mb-2">
          <span>Tạm tính:</span>
          <span><%= totalPrice.toLocaleString('vi-VN') %>đ</span>
        </div>
        <div class="d-flex justify-content-between mb-3">
          <span>Phí ship:</span>
          <span class="text-success">Miễn phí</span>
        </div>
        <hr>
        <div class="d-flex justify-content-between fw-bold mb-3">
          <span>Tổng cộng:</span>
          <span class="text-danger"><%= totalPrice.toLocaleString('vi-VN') %>đ</span>
        </div>
        <a href="/checkout" class="btn btn-dark w-100">Thanh toán →</a>
        <a href="/shop" class="btn btn-outline-secondary w-100 mt-2">← Tiếp tục mua</a>
      </div>
    </div>
  </div>
<% } else { %>
  <!-- Giỏ hàng trống -->
  <div class="text-center py-5">
    <i class="bi bi-cart-x" style="font-size:4rem; color:#ccc;"></i>
    <h5 class="mt-3 text-muted">Giỏ hàng trống</h5>
    <a href="/shop" class="btn btn-dark mt-2">Mua ngay</a>
  </div>
<% } %>

