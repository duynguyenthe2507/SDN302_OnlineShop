<div class="container">
  <div class="shop-breadcrumb"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right mx-1"></i> Giỏ hàng</div>
  <div class="d-flex justify-content-between align-items-end mb-4"><div><div class="section-kicker">Túi mua sắm</div><h1 class="mb-0" style="font-family:Georgia,serif;font-weight:500">Giỏ hàng</h1></div><span class="text-muted small"><%= cartItems.length %> sản phẩm</span></div>
  <% if (cartItems && cartItems.length) { %>
    <div class="row g-4"><div class="col-lg-8"><div class="surface-card p-3 p-md-4"><div class="table-responsive"><table class="table cart-table align-middle mb-0"><thead><tr><th colspan="2">Sản phẩm</th><th>Đơn giá</th><th>Phân loại</th><th>Số lượng</th><th></th></tr></thead><tbody>
      <% cartItems.forEach(item => { %><tr><td><img src="<%= item.product.image || 'https://placehold.co/200x250/f2eee6/65746a?text=FASHION' %>" alt="<%= item.product.name %>"></td><td class="fw-semibold"><%= item.product.name %></td><td><%= item.product.price.toLocaleString('vi-VN') %>₫</td><td class="small text-muted"><%= item.size || '—' %> · <%= item.color || '—' %></td><td><span class="badge text-bg-light"><%= item.quantity %></span></td><td><form action="/cart/remove/<%= item._id %>" method="POST"><button class="btn btn-sm btn-outline-secondary" title="Xóa"><i class="bi bi-trash"></i></button></form></td></tr><% }) %>
    </tbody></table></div></div><a href="/shop" class="btn btn-link text-dark text-decoration-none px-0 mt-3"><i class="bi bi-arrow-left me-2"></i>Tiếp tục mua sắm</a></div>
    <aside class="col-lg-4"><div class="summary-card summary-sticky"><div class="section-kicker">Tóm tắt</div><h2 class="h3 mt-1 mb-4">Đơn hàng của bạn</h2><div class="d-flex justify-content-between mb-3"><span class="text-muted">Tạm tính</span><strong><%= totalPrice.toLocaleString('vi-VN') %>₫</strong></div><div class="d-flex justify-content-between mb-3"><span class="text-muted">Giao hàng</span><span class="text-success">Miễn phí</span></div><hr><div class="d-flex justify-content-between mb-4"><strong>Tổng cộng</strong><strong class="product-price"><%= totalPrice.toLocaleString('vi-VN') %>₫</strong></div><a href="/checkout" class="btn btn-shop-dark w-100">Tiến hành thanh toán <i class="bi bi-arrow-right ms-2"></i></a><p class="small text-muted mt-3 mb-0"><i class="bi bi-shield-check me-1"></i> Thông tin giao dịch được bảo vệ.</p></div></aside></div>
  <% } else { %><div class="surface-card text-center py-5 px-3"><i class="bi bi-bag fs-1 text-muted"></i><h2 class="h4 mt-3">Giỏ hàng đang trống</h2><p class="text-muted">Khám phá bộ sưu tập và chọn món đồ bạn yêu thích.</p><a href="/shop" class="btn btn-shop-dark">Khám phá sản phẩm</a></div><% } %>
</div>
