<div class="container">
  <section class="hero-panel">
    <div class="hero-copy"><div class="eyebrow">Bộ sưu tập mới · 2026</div><h1>Mặc điều bạn<br>thấy là mình.</h1><p>Thiết kế tối giản, chất liệu dễ chịu và những món đồ bạn sẽ muốn mặc mỗi ngày.</p><a href="/shop" class="btn btn-shop-light mt-2">Khám phá bộ sưu tập <i class="bi bi-arrow-right ms-2"></i></a></div>
  </section>

  <section>
    <div class="section-heading"><div><div class="section-kicker">Khám phá theo phong cách</div><h2>Danh mục nổi bật</h2></div><a href="/shop" class="small text-dark text-decoration-none">Xem tất cả <i class="bi bi-arrow-up-right"></i></a></div>
    <div class="row g-3">
      <% if (categories && categories.length) { categories.forEach((cat, i) => { %>
        <div class="col-6 col-md-3"><a class="category-tile" href="/shop?category=<%= cat._id %>"><div><span class="section-kicker">0<%= i+1 %></span><br><strong><%= cat.name %></strong></div><i class="bi bi-arrow-up-right"></i></a></div>
      <% }) } else { ['Áo thun','Áo sơ mi','Quần','Áo khoác'].forEach((name, i) => { %><div class="col-6 col-md-3"><a class="category-tile" href="/shop"><div><span class="section-kicker">0<%= i+1 %></span><br><strong><%= name %></strong></div><i class="bi bi-arrow-up-right"></i></a></div><% }) } %>
    </div>
  </section>

  <section>
    <div class="section-heading"><div><div class="section-kicker">Được chọn cho bạn</div><h2>Sản phẩm mới nhất</h2></div><a href="/shop" class="small text-dark text-decoration-none">Tới cửa hàng <i class="bi bi-arrow-up-right"></i></a></div>
    <div class="row product-grid">
      <% if (featuredProducts && featuredProducts.length) { featuredProducts.forEach(product => { %><%- include('../partials/product-card', { product }) %><% }) } else { %><div class="col-12"><div class="surface-card p-5 text-center text-muted">Sản phẩm mới sẽ sớm được cập nhật.</div></div><% } %>
    </div>
  </section>

  <section class="mt-5 p-4 p-md-5" style="background:var(--cream);border-radius:5px"><div class="row align-items-center g-3"><div class="col-md-8"><div class="section-kicker">Mua sắm tự tin</div><h2 class="mt-2" style="font-family:Georgia,serif;font-weight:500">Chọn đúng món đồ, an tâm từng bước.</h2><p class="text-muted mb-0">Đặt hàng nhanh, theo dõi trạng thái rõ ràng và lựa chọn thanh toán phù hợp.</p></div><div class="col-md-4 text-md-end"><a href="/shop" class="btn btn-shop-dark">Bắt đầu mua sắm</a></div></div></section>
</div>
