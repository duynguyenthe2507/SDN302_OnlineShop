<h4 class="mb-4">Chi tiết đơn hàng #<%= order._id.toString().slice(-8).toUpperCase() %></h4>
<div class="card mb-3">
  <div class="card-header">Sản phẩm đã đặt</div>
  <div class="card-body p-0"><table class="table mb-0"><thead><tr><th>Sản phẩm</th><th>Size / màu</th><th>Số lượng</th><th>Đơn giá</th></tr></thead><tbody>
    <% order.items.forEach(item => { %><tr><td><%= item.productName %></td><td><%= item.size %> / <%= item.color %></td><td><%= item.quantity %></td><td><%= item.price.toLocaleString('vi-VN') %>đ</td></tr><% }) %>
  </tbody></table></div>
</div>
<div class="card p-3"><p><strong>Người nhận:</strong> <%= order.name %></p><p><strong>Số điện thoại:</strong> <%= order.phone %></p><p><strong>Địa chỉ:</strong> <%= order.address %></p><p><strong>Thanh toán:</strong> <%= order.paymentMethod === 'payos' ? 'PayOS mô phỏng' : order.paymentMethod === 'cod' ? 'COD' : 'Chuyển khoản' %> · <%= order.paymentStatus === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán' %></p><p><strong>Trạng thái:</strong> <%= order.status %></p><p class="mb-0"><strong>Tổng tiền:</strong> <span class="text-danger"><%= order.totalPrice.toLocaleString('vi-VN') %>đ</span></p></div>
<% if (order.paymentMethod === 'payos' && order.paymentStatus !== 'paid' && order.status !== 'cancelled') { %><a class="btn btn-shop-dark mt-3" href="/payment/payos/<%= order._id %>">Tiếp tục thanh toán mô phỏng</a><% } %>
<a href="/order-history" class="btn btn-outline-secondary mt-3">← Về lịch sử đơn hàng</a>
