<!-- ===== TRANG ĐẶT HÀNG THÀNH CÔNG ===== -->
<div class="text-center py-5">
  <!-- Icon tick xanh -->
  <div class="mb-4">
    <i class="bi bi-check-circle-fill text-success" style="font-size:5rem;"></i>
  </div>
  <h3 class="fw-bold">Đặt hàng thành công!</h3>
  <p class="text-muted mb-1">Cảm ơn bạn đã mua hàng tại FashionShop.</p>
  <p class="text-muted">Mã đơn hàng: <strong class="text-dark">#<%= order ? order._id : 'N/A' %></strong></p>

  <!-- Thông tin đơn hàng tóm tắt -->
  <% if (order) { %>
    <div class="card mx-auto mt-4" style="max-width:500px;">
      <div class="card-body text-start">
        <p><strong>Người nhận:</strong> <%= order.name %></p>
        <p><strong>SĐT:</strong> <%= order.phone %></p>
        <p><strong>Địa chỉ:</strong> <%= order.address %></p>
        <p><strong>Tổng tiền:</strong> <span class="text-danger"><%= order.totalPrice.toLocaleString('vi-VN') %>đ</span></p>
        <p><strong>Thanh toán:</strong> <%= order.paymentMethod === 'cod' ? 'COD - Thanh toán khi nhận hàng' : 'Chuyển khoản' %></p>
      </div>
    </div>
  <% } %>

  <div class="mt-4 d-flex justify-content-center gap-3">
    <a href="/order-history" class="btn btn-dark">Xem đơn hàng của tôi</a>
    <a href="/shop" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
  </div>
</div>

