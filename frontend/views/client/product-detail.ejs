<div class="container">
  <div class="shop-breadcrumb"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right mx-1"></i><a href="/shop">Cửa hàng</a> <i class="bi bi-chevron-right mx-1"></i><%= product.name %></div>
  <div class="row g-4">
    <div class="col-lg-7"><img class="detail-image" src="<%= product.image || 'https://placehold.co/900x1100/f2eee6/65746a?text=FASHION' %>" alt="<%= product.name %>"></div>
    <div class="col-lg-5"><div class="detail-info">
      <div class="section-kicker"><%= product.category ? product.category.name : 'FASHION COLLECTION' %></div><h1 class="mt-2"><%= product.name %></h1>
      <div class="detail-price my-3"><%= product.price.toLocaleString('vi-VN') %>₫</div>
      <p class="text-muted"><%= product.description || 'Thiết kế dễ mặc, chất liệu thoải mái và phù hợp với phong cách hằng ngày.' %></p>
      <div class="d-flex gap-3 small text-muted py-3 border-top border-bottom"><span><i class="bi bi-truck me-1"></i> Giao hàng toàn quốc</span><span><i class="bi bi-arrow-repeat me-1"></i> Đổi trả 7 ngày</span></div>
      <form action="/cart/add" method="POST" class="mt-4"><input type="hidden" name="productId" value="<%= product._id %>">
        <% const availableSizes = product.sizes && product.sizes.length ? product.sizes : ['S','M','L','XL','XXL']; %>
        <% if (availableSizes.length) { %><div class="mb-4"><div class="d-flex justify-content-between mb-2"><label class="form-label mb-0">Kích cỡ</label><span class="small text-muted">Chọn một kích cỡ</span></div><div class="d-flex gap-2 flex-wrap"><% availableSizes.forEach((size,i) => { %><div class="choice-pill position-relative"><input type="radio" name="size" value="<%= size %>" id="size-<%= i %>" <%= i===0?'checked':'' %>><label for="size-<%= i %>"><%= size %></label></div><% }) %></div></div><% } else { %><input type="hidden" name="size" value=""><% } %>
        <% if (product.colors && product.colors.length) { %><div class="mb-4"><label class="form-label d-block">Màu sắc</label><div class="d-flex gap-2 flex-wrap"><% product.colors.forEach((color,i) => { %><div class="choice-pill position-relative"><input type="radio" name="color" value="<%= color %>" id="color-<%= i %>" <%= i===0?'checked':'' %>><label for="color-<%= i %>"><%= color %></label></div><% }) %></div></div><% } else { %><input type="hidden" name="color" value="default"><% } %>
        <div class="mb-4"><label class="form-label" for="quantity">Số lượng</label><div><input id="quantity" type="number" class="form-control quantity-input" name="quantity" value="1" min="1" max="<%= Math.max(product.stock,1) %>" <%= product.stock < 1 ? 'disabled' : '' %>></div><div class="small text-muted mt-2"><%= product.stock > 0 ? `${product.stock} sản phẩm có sẵn` : 'Sản phẩm tạm hết hàng' %></div></div>
        <button class="btn btn-shop-dark btn-lg w-100" <%= product.stock < 1 ? 'disabled' : '' %>><i class="bi bi-bag-plus me-2"></i>Thêm vào giỏ hàng</button><a href="/shop" class="btn btn-outline-secondary w-100 mt-2">Tiếp tục mua sắm</a>
      </form>
    </div></div>
  </div>
</div>
