<div class="container">
  <div class="shop-breadcrumb"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right mx-1"></i> Cửa hàng</div>
  <div class="shop-toolbar d-flex flex-wrap justify-content-between align-items-end gap-3"><div><div class="section-kicker">Bộ sưu tập FASHION</div><h1 class="mb-1" style="font-family:Georgia,serif;font-weight:500">Cửa hàng</h1><div class="small text-muted">Tìm thấy <strong><%= totalProducts || 0 %></strong> sản phẩm</div></div>
    <form action="/shop" method="GET" class="d-flex align-items-center gap-2"><% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"><% } %><% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %><% if (filters.minPrice) { %><input type="hidden" name="minPrice" value="<%= filters.minPrice %>"><% } %><% if (filters.maxPrice) { %><input type="hidden" name="maxPrice" value="<%= filters.maxPrice %>"><% } %><label for="sort" class="small text-muted">Sắp xếp</label><select id="sort" name="sort" class="form-select form-select-sm" onchange="this.form.submit()"><option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>>Mới nhất</option><option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Giá thấp đến cao</option><option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Giá cao đến thấp</option></select></form>
  </div>
  <div class="row g-4">
    <aside class="col-lg-3"><div class="filter-card"><div class="filter-title mb-3">Bộ lọc</div><form action="/shop" method="GET">
      <div class="mb-4"><label class="form-label">Từ khóa</label><input type="search" class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Tên sản phẩm"></div>
      <div class="mb-4"><label class="form-label">Danh mục</label><select class="form-select" name="category"><option value="">Tất cả danh mục</option><% if (categories) { categories.forEach(cat => { %><option value="<%= cat._id %>" <%= filters.category === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option><% }) } %></select></div>
      <div class="mb-4"><label class="form-label">Khoảng giá (₫)</label><div class="d-flex gap-2"><input type="number" min="0" class="form-control" name="minPrice" value="<%= filters.minPrice || '' %>" placeholder="Từ"><input type="number" min="0" class="form-control" name="maxPrice" value="<%= filters.maxPrice || '' %>" placeholder="Đến"></div></div>
      <% if (filters.sort) { %><input type="hidden" name="sort" value="<%= filters.sort %>"><% } %><button class="btn btn-shop-dark w-100">Áp dụng bộ lọc</button><a href="/shop" class="btn btn-outline-secondary w-100 mt-2">Xóa bộ lọc</a>
    </form></div></aside>
    <section class="col-lg-9"><div class="row product-grid">
      <% if (products && products.length) { products.forEach(product => { %><%- include('../partials/product-card', { product }) %><% }) } else { %><div class="col-12"><div class="surface-card text-center p-5"><i class="bi bi-search fs-2 text-muted"></i><h3 class="h5 mt-3">Chưa tìm thấy sản phẩm</h3><p class="text-muted">Thử đổi từ khóa hoặc bộ lọc của bạn.</p><a href="/shop" class="btn btn-shop-dark">Xem tất cả sản phẩm</a></div></div><% } %>
    </div><div class="mt-5"><%- include('../partials/pagination', { currentPage, totalPages, baseUrl: '/shop' }) %></div></section>
  </div>
</div>
