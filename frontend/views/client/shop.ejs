<!-- ===== TRANG CỬA HÀNG (Danh sách sản phẩm + Bộ lọc + Phân trang) ===== -->
<div class="row">
  <!-- ===== CỘT BỘ LỌC (trái) ===== -->
  <div class="col-md-3">
    <div class="card p-3 mb-3">
      <h6 class="fw-bold mb-3">Bộ lọc</h6>
      <form action="/shop" method="GET">
        <!-- Lọc theo danh mục -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Danh mục</label>
          <% if (categories) { %>
            <% categories.forEach(cat => { %>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="category" value="<%= cat._id %>"
                  <%= filters.category === String(cat._id) ? 'checked' : '' %>>
                <label class="form-check-label"><%= cat.name %></label>
              </div>
            <% }) %>
          <% } %>
        </div>
        <!-- Lọc theo giá -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Khoảng giá</label>
          <input type="number" name="minPrice" class="form-control mb-1" placeholder="Giá từ" value="<%= filters.minPrice || '' %>">
          <input type="number" name="maxPrice" class="form-control" placeholder="Đến giá" value="<%= filters.maxPrice || '' %>">
        </div>
        <button type="submit" class="btn btn-dark w-100">Áp dụng</button>
        <a href="/shop" class="btn btn-outline-secondary w-100 mt-2">Xóa bộ lọc</a>
      </form>
    </div>
  </div>

  <!-- ===== CỘT SẢN PHẨM (phải) ===== -->
  <div class="col-md-9">
    <!-- Tiêu đề + sắp xếp -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <span class="text-muted">Tìm thấy <strong><%= totalProducts || 0 %></strong> sản phẩm</span>
      <form action="/shop" method="GET">
        <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Sắp xếp theo</option>
          <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Giá tăng dần</option>
          <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Giá giảm dần</option>
          <option value="newest"     <%= filters.sort === 'newest'     ? 'selected' : '' %>>Mới nhất</option>
        </select>
      </form>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="row g-3">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="col-6 col-md-4">
            <div class="card h-100">
              <img src="<%= product.image || '/images/no-image.png' %>" class="card-img-top" alt="<%= product.name %>" style="height:200px; object-fit:cover;">
              <div class="card-body">
                <h6 class="card-title"><%= product.name %></h6>
                <p class="text-danger fw-bold mb-1"><%= product.price.toLocaleString('vi-VN') %>đ</p>
                <p class="text-muted small mb-2"><%= product.category ? product.category.name : '' %></p>
                <a href="/product/<%= product._id %>" class="btn btn-dark btn-sm w-100">Xem</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <p class="text-center text-muted py-5">Không tìm thấy sản phẩm nào.</p>
        </div>
      <% } %>
    </div>

    <!-- Phân trang -->
    <div class="mt-4">
      <%- include('../partials/pagination', { currentPage, totalPages, baseUrl: '/shop' }) %>
    </div>
  </div>
</div>

