<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Admin - FashionShop' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    /* Sidebar cố định bên trái */
    #sidebar { width: 250px; min-height: 100vh; background: #1a1a1a; }
    #sidebar a { color: #ccc; text-decoration: none; }
    #sidebar a:hover, #sidebar a.active { color: #fff; background: #333; }
    #main-content { margin-left: 250px; }
    .top-bar { background: #fff; border-bottom: 1px solid #dee2e6; }
  </style>
</head>
<body class="bg-light">

<div class="d-flex">
  <!-- ===== SIDEBAR ===== -->
  <%- include('../partials/admin-sidebar') %>

  <!-- ===== NỘI DUNG CHÍNH ===== -->
  <div id="main-content" class="flex-grow-1">
    <!-- Top bar -->
    <div class="top-bar p-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><%= title || 'Dashboard' %></h5>
      <span>Xin chào, <strong><%= admin ? admin.name : 'Admin' %></strong></span>
    </div>

    <% if (error) { %><div class="alert alert-danger m-3"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success m-3"><%= success %></div><% } %>

    <!-- Nội dung trang admin được inject vào đây -->
    <div class="p-4">
      <%- body %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

