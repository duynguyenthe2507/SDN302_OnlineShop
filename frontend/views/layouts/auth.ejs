<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'FashionShop' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Căn giữa form theo chiều dọc */
    body { background: #f5f5f5; display: flex; align-items: center; min-height: 100vh; }
    .auth-card { max-width: 420px; width: 100%; margin: auto; }
    .brand { font-size: 2rem; font-weight: 700; letter-spacing: 3px; }
  </style>
</head>
<body>
  <div class="auth-card p-4">
    <!-- Logo -->
    <div class="text-center mb-4">
      <a href="/" class="text-dark text-decoration-none brand">FASHION</a>
    </div>

    <!-- Nội dung form được inject vào đây -->
    <%- body %>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

