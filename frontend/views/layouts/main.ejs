<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'FashionShop' %></title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { font-family: 'Segoe UI', sans-serif; }
    .navbar-brand { font-weight: 700; letter-spacing: 2px; font-size: 1.5rem; }
    footer { background: #1a1a1a; color: #ccc; }
  </style>
</head>
<body>

  <!-- ===== HEADER / NAVIGATION ===== -->
  <%- include('../partials/header') %>

  <% if (error) { %><div class="container mt-3"><div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div><% } %>
  <% if (success) { %><div class="container mt-3"><div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div><% } %>

  <!-- ===== NỘI DUNG TRANG (được inject vào đây) ===== -->
  <main class="container my-4">
    <%- body %>
  </main>

  <!-- ===== FOOTER ===== -->
  <%- include('../partials/footer') %>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

