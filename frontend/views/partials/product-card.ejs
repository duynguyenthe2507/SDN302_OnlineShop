<div class="col-6 col-lg-3">
  <article class="card product-card">
    <a href="/product/<%= product._id %>" class="product-quick-link">
      <div class="product-image-wrap"><img src="<%= product.image || 'https://placehold.co/800x1000/f2eee6/65746a?text=FASHION' %>" class="card-img-top" alt="<%= product.name %>" loading="lazy"><% if (product.stock <= 0) { %><span class="badge text-bg-secondary position-absolute top-0 start-0 m-3">Tạm hết hàng</span><% } else if (product.createdAt && Date.now() - new Date(product.createdAt).getTime() < 1209600000) { %><span class="badge text-bg-light position-absolute top-0 start-0 m-3">Mới</span><% } %></div>
      <div class="card-body"><div class="product-category"><%= product.category ? product.category.name : 'FASHION' %></div><h3 class="card-title"><%= product.name %></h3><div class="d-flex justify-content-between align-items-center"><span class="product-price"><%= product.price.toLocaleString('vi-VN') %>₫</span><span class="small text-muted"><i class="bi bi-arrow-up-right"></i></span></div></div>
    </a>
  </article>
</div>
